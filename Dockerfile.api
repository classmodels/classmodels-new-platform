# Build vanaf monorepo-root: docker build -f Dockerfile.api .
# Bruikbaar voor Railway (Docker) of andere hosts. Combell gebruikt dit niet standaard.
FROM node:22-bookworm-slim AS build
WORKDIR /repo
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci
RUN npm run build -w @cm/shared
WORKDIR /repo/apps/api
RUN npx prisma generate
RUN npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
# Railway zet PORT. Fallback 4000 voor lokaal/Docker.
ENV API_HOST=0.0.0.0
# Mediatheek: met MEDIA_BACKEND=r2 niet nodig; anders mount volume.
ENV MEDIA_ROOT=/data/media
RUN mkdir -p /data/media
COPY --from=build /repo/package.json ./
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/apps/api/dist ./dist
COPY --from=build /repo/apps/api/prisma ./prisma
COPY --from=build /repo/packages ./packages
EXPOSE 4000
# Nest-output staat onder dist/src/main.js in deze monorepo.
CMD ["node", "dist/src/main.js"]
